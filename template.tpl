___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const successCb = data.successCb || data.gtmOnSuccess;
const failureCb = data.failureCb || data.gtmOnFailure;

const injectScript = require('injectScript');

const env = data.env;
const raiserId = data.raiserId;
const adsPrefix = data.adsPrefix;
const adServer = data.adServer;
const baseUrl = env == 'staging' ? 'https://static.gimii.dev' : 'https://static.gimii.fr';
let url = baseUrl + '/gimii.js' + '?raiserId=' + raiserId + '&adServer=' + adServer;


if(adsPrefix) {
   url += "&adsTagPrefix=" + adsPrefix;
}


injectScript(url, successCb, failureCb);


